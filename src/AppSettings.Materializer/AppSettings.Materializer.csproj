<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AppSettings.Materializer</AssemblyName>
    <RootNamespace>AppSettings.Materializer</RootNamespace>
    <PackageId>AppSettings.Materializer</PackageId>
    <Description>Materialize layered ASP.NET Core JSON configuration into one deterministic file.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>
</Project>
